# Copy this file to .env and fill in the values.

# Free key from https://console.groq.com . Leave empty to run without AI
# (the app still works: manual category + rule-based flags).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=8

# Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite by default. For Postgres on Render use the Internal Database URL.
DATABASE_URL=sqlite:///./spendflow.db

# Comma-separated list of allowed frontend origins (add your Vercel URL).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create demo users, budgets and expenses on first start when the DB is empty.
SEED_DEMO=true

# Expenses at or above this amount are flagged by the rule engine.
HIGH_AMOUNT_THRESHOLD=50000
